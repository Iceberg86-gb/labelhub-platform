{
  "scoringRuleVersion": "equal-weight-three-zone-v2",
  "description": "AiReviewScoringPolicy contract: equal-weight average of the configured dimensions (HALF_UP, 4 dp), each score clamped to [0,1]; a configured dimension the model omitted falls back to the clamped overall confidence (0 if absent); no configured dimensions means ['overall']. finalScore >= passThreshold -> pass, finalScore <= rejectThreshold -> reject, else manual_review.",
  "cases": [
    {"name": "average above pass", "dimensions": ["accuracy", "format"], "dimensionScores": [{"dimension": "accuracy", "score": 0.9}, {"dimension": "format", "score": 0.8}], "confidence": 0.5, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.8500", "expectedRecommendation": "pass"},
    {"name": "exactly at pass threshold passes", "dimensions": ["quality"], "dimensionScores": [{"dimension": "quality", "score": 0.8}], "confidence": 0.1, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.8000", "expectedRecommendation": "pass"},
    {"name": "exactly at reject threshold rejects", "dimensions": ["quality"], "dimensionScores": [{"dimension": "quality", "score": 0.2}], "confidence": 0.9, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.2000", "expectedRecommendation": "reject"},
    {"name": "middle zone goes to manual review", "dimensions": ["helpfulness", "correctness"], "dimensionScores": [{"dimension": "helpfulness", "score": 0.7}, {"dimension": "correctness", "score": 0.4}], "confidence": 0.9, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.5500", "expectedRecommendation": "manual_review"},
    {"name": "half-up rounding to four decimals", "dimensions": ["a", "b", "c"], "dimensionScores": [{"dimension": "a", "score": 0.66667}, {"dimension": "b", "score": 0.66667}, {"dimension": "c", "score": 0.66667}], "confidence": 0, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.6667", "expectedRecommendation": "manual_review"},
    {"name": "omitted dimension falls back to confidence", "dimensions": ["helpfulness", "correctness"], "dimensionScores": [{"dimension": "helpfulness", "score": 1.0}], "confidence": 0.4, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.7000", "expectedRecommendation": "manual_review"},
    {"name": "omitted dimension and no confidence counts as zero", "dimensions": ["helpfulness", "correctness"], "dimensionScores": [{"dimension": "helpfulness", "score": 0.6}], "confidence": null, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.3000", "expectedRecommendation": "manual_review"},
    {"name": "out of range scores are clamped", "dimensions": ["x", "y"], "dimensionScores": [{"dimension": "x", "score": 1.7}, {"dimension": "y", "score": -0.3}], "confidence": 0.5, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.5000", "expectedRecommendation": "manual_review"},
    {"name": "unconfigured dimensions from the model are ignored", "dimensions": ["quality"], "dimensionScores": [{"dimension": "quality", "score": 0.1}, {"dimension": "extra", "score": 1.0}], "confidence": 0.9, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.1000", "expectedRecommendation": "reject"},
    {"name": "no configured dimensions means overall", "dimensions": [], "dimensionScores": [{"dimension": "overall", "score": 0.95}], "confidence": 0.1, "passThreshold": "0.80", "rejectThreshold": "0.20", "expectedFinalScore": "0.9500", "expectedRecommendation": "pass"},
    {"name": "custom rule thresholds", "dimensions": ["quality"], "dimensionScores": [{"dimension": "quality", "score": 0.6}], "confidence": 0.6, "passThreshold": "0.60", "rejectThreshold": "0.40", "expectedFinalScore": "0.6000", "expectedRecommendation": "pass"}
  ]
}
